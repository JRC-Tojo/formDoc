{
 "format": "formdoc-template",
 "version": 1,
 "name": "I形断面",
 "description": "I形断面（H形鋼）の寸法図と断面積。寸法を入れると図と値が変わる。汎用図形で描いているので、図形を描き足して使い回せる。",
 "category": "断面",
 "styles": [],
 "created": "2026-10-02",
 "blocks": [
  {
   "id": "t1",
   "kind": "vdef",
   "props": {
    "name": "H",
    "value": 700,
    "unit": "mm",
    "desc": "桁高",
    "show": false
   }
  },
  {
   "id": "t2",
   "kind": "vdef",
   "props": {
    "name": "B",
    "value": 350,
    "unit": "mm",
    "desc": "フランジ幅",
    "show": false
   }
  },
  {
   "id": "t3",
   "kind": "vdef",
   "props": {
    "name": "t_w",
    "value": 12,
    "unit": "mm",
    "desc": "腹板厚",
    "show": false
   }
  },
  {
   "id": "t4",
   "kind": "vdef",
   "props": {
    "name": "t_f",
    "value": 22,
    "unit": "mm",
    "desc": "フランジ厚",
    "show": false
   }
  },
  {
   "id": "t5",
   "kind": "fig-shapes",
   "props": {
    "caption": "I形断面",
    "scale": 0.006,
    "shapes": [
     {
      "kind": "rect",
      "x1": "-B / 2",
      "y1": "0",
      "x2": "B / 2",
      "y2": "t_f",
      "fill": "gray"
     },
     {
      "kind": "rect",
      "x1": "-B / 2",
      "y1": "H - t_f",
      "x2": "B / 2",
      "y2": "H",
      "fill": "gray"
     },
     {
      "kind": "rect",
      "x1": "-t_w / 2",
      "y1": "t_f",
      "x2": "t_w / 2",
      "y2": "H - t_f",
      "fill": "gray"
     },
     {
      "kind": "dim",
      "x1": "-B / 2",
      "y1": "H + 60",
      "x2": "B / 2",
      "y2": "H + 60",
      "label": "{{B}}"
     },
     {
      "kind": "dim",
      "x1": "-B / 2 - 80",
      "y1": "0",
      "x2": "-B / 2 - 80",
      "y2": "H",
      "label": "{{H}}"
     },
     {
      "kind": "text",
      "x1": "t_w / 2 + 60",
      "y1": "H / 2",
      "label": "{{t_w}}"
     },
     {
      "kind": "text",
      "x1": "B / 2 + 60",
      "y1": "H - t_f / 2",
      "label": "{{t_f}}"
     }
    ]
   }
  },
  {
   "id": "t6",
   "kind": "paragraph",
   "props": {
    "text": "H−{{H}}×{{B}}×{{t_w}}×{{t_f}}"
   }
  },
  {
   "id": "t7",
   "kind": "calc",
   "props": {
    "name": "A",
    "expr": "2 * B * t_f + (H - 2 * t_f) * t_w",
    "unit": "mm2",
    "digits": 0,
    "desc": "断面積"
   }
  }
 ],
 "interface": {
  "inputs": [
   {
    "name": "H",
    "label": "桁高",
    "unit": "mm",
    "default": 700
   },
   {
    "name": "B",
    "label": "フランジ幅",
    "unit": "mm",
    "default": 350
   },
   {
    "name": "t_w",
    "label": "腹板厚",
    "unit": "mm",
    "default": 12
   },
   {
    "name": "t_f",
    "label": "フランジ厚",
    "unit": "mm",
    "default": 22
   }
  ],
  "exports": [
   {
    "name": "A",
    "label": "断面積"
   }
  ]
 },
 "assets": {}
}