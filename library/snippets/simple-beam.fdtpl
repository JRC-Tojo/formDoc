{
 "format": "formdoc-template",
 "version": 1,
 "name": "単純梁と集中荷重（影響線つき）",
 "description": "単純梁に集中荷重を等間隔で n 個載せた図と、左支点反力の影響線。荷重の数・間隔を変えると図と縦距（η = 1 − x/L）が自動で変わる。縦距の和 Ση を公開する。",
 "category": "荷重",
 "styles": [],
 "created": "2026-10-02",
 "blocks": [
  {
   "id": "t1",
   "kind": "vdef",
   "props": {
    "name": "L",
    "value": 8.0,
    "unit": "m",
    "desc": "支間長",
    "show": false
   }
  },
  {
   "id": "t2",
   "kind": "vdef",
   "props": {
    "name": "a",
    "value": 3.0,
    "unit": "m",
    "desc": "左支点から最初の荷重までの距離",
    "show": false
   }
  },
  {
   "id": "t3",
   "kind": "vdef",
   "props": {
    "name": "s",
    "value": 2.8,
    "unit": "m",
    "desc": "荷重の間隔",
    "show": false
   }
  },
  {
   "id": "t4",
   "kind": "vdef",
   "props": {
    "name": "n",
    "value": 2,
    "unit": "",
    "desc": "荷重の数",
    "show": false,
    "digits": 0
   }
  },
  {
   "id": "t5",
   "kind": "fig-shapes",
   "props": {
    "caption": "載荷状態と左支点反力の影響線",
    "scale": 1.0,
    "shapes": [
     {
      "kind": "line",
      "x1": "0",
      "y1": "0",
      "x2": "L",
      "y2": "0"
     },
     {
      "kind": "polygon",
      "pts": "0, 0; -0.15, -0.3; 0.15, -0.3"
     },
     {
      "kind": "polygon",
      "pts": "L, 0; L - 0.15, -0.3; L + 0.15, -0.3"
     },
     {
      "kind": "arrow",
      "x1": "a",
      "y1": "1",
      "x2": "a",
      "y2": "0.05",
      "nx": "n",
      "dx": "s"
     },
     {
      "kind": "text",
      "x1": "a",
      "y1": "1.2",
      "label": "P{{ix + 1:0}}",
      "nx": "n",
      "dx": "s"
     },
     {
      "kind": "dim",
      "x1": "0",
      "y1": "1.9",
      "x2": "L",
      "y2": "1.9",
      "label": "{{L}}"
     },
     {
      "kind": "dim",
      "x1": "0",
      "y1": "1.55",
      "x2": "a",
      "y2": "1.55",
      "label": "{{a}}"
     },
     {
      "kind": "dim",
      "x1": "a",
      "y1": "1.55",
      "x2": "a + s",
      "y2": "1.55",
      "label": "{{s}}",
      "nx": "n - 1",
      "dx": "s"
     },
     {
      "kind": "line",
      "x1": "0",
      "y1": "-1.0",
      "x2": "L",
      "y2": "-1.0"
     },
     {
      "kind": "line",
      "x1": "0",
      "y1": "-1.0",
      "x2": "0",
      "y2": "-2.0"
     },
     {
      "kind": "line",
      "x1": "0",
      "y1": "-2.0",
      "x2": "L",
      "y2": "-1.0"
     },
     {
      "kind": "line",
      "x1": "a",
      "y1": "-1.0",
      "x2": "a",
      "y2": "-1.0 - (1 - (a + ix * s) / L)",
      "nx": "n",
      "dx": "s"
     },
     {
      "kind": "text",
      "x1": "a",
      "y1": "-1.0 - (1 - (a + ix * s) / L) - 0.3",
      "label": "{{1 - (a + ix * s) / L:3}}",
      "nx": "n",
      "dx": "s"
     },
     {
      "kind": "text",
      "x1": "-0.6",
      "y1": "-1.5",
      "label": "1.0"
     }
    ]
   }
  },
  {
   "id": "t6",
   "kind": "calc",
   "props": {
    "name": "eta_sum",
    "expr": "n * (1 - a / L) - s * n * (n - 1) / (2 * L)",
    "digits": 3,
    "desc": "影響線縦距の和",
    "display": "Σ eta",
    "show_symbolic": true
   }
  }
 ],
 "interface": {
  "inputs": [
   {
    "name": "L",
    "label": "支間長",
    "unit": "m",
    "default": 8.0
   },
   {
    "name": "a",
    "label": "最初の荷重の位置",
    "unit": "m",
    "default": 3.0
   },
   {
    "name": "s",
    "label": "荷重の間隔",
    "unit": "m",
    "default": 2.8
   },
   {
    "name": "n",
    "label": "荷重の数",
    "unit": "",
    "default": 2
   }
  ],
  "exports": [
   {
    "name": "eta_sum",
    "label": "影響線縦距の和"
   }
  ]
 },
 "assets": {}
}