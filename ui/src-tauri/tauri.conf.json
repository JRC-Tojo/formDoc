{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formDoc",
  "identifier": "jp.formdoc.desktop",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev:desktop",
    "beforeBuildCommand": "bun run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "formDoc",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "fdoc"
        ],
        "name": "formDoc 文書",
        "description": "formDoc 文書",
        "role": "Editor",
        "mimeType": "application/x-formdoc"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNjA2RjYzRkE4NEFGRTQKUldUa3I0VDZZMjlndS9xeTRVSEJhRUNySm9kOGFDaUxCdEVZYlNvZlFXcVE1UTc0bkkrT3BianQK",
      "endpoints": [
        "https://github.com/JRC-Tojo/formDoc/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}