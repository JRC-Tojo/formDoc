{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの権限（ダイアログ、閉じる前の確認、タイトル。ファイルの読み書きはアプリ側のコマンドで行う）",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title"
  ]
}