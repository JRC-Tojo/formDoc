{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの権限（ダイアログ、閉じる前の確認、タイトル、自動更新と再起動。ファイルの読み書きはアプリ側のコマンドで行う）",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "updater:default",
    "process:allow-restart"
  ]
}