{
  "name": "formdoc-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node ../scripts/setup.mjs",
    "dev": "vite --mode web",
    "dev:desktop": "vite --mode desktop",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:web": "npm run build:wasm && vite build --mode web",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview --mode web",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.0",
    "vite": "^8.3.2"
  }
}
