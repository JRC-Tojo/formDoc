    "desc": "鋼材のヤング係数",
    "show": false
   }
  },
  {
   "id": "b26",
   "kind": "vdef",
   "props": {
    "name": "nu",
    "value": 0.3,
    "digits": 1,
    "desc": "鋼材のポアソン比",
    "show": false
