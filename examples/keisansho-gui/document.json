  {
   "id": "b6",
   "kind": "vdef",
   "props": {
    "name": "V",
    "value": 110,
    "unit": "km/h",
    "desc": "当該区間を走行する列車の最高速度",
    "show": false
   }
  },
  {
   "id": "b7",
   "kind": "vdef",
   "props": {
    "name": "L_b",
    "value": 8.0,
    "unit": "m",
    "desc": "部材に最大活荷重断面力を生じさせる同符号の影響線の基線の長さ",
    "show": false,
    "global": true
   }
  },
  {
   "id": "b8",
   "kind": "vdef",
   "props": {
    "name": "K_a",
    "value": 2.0,
    "digits": 1,
    "desc": "係数で，在来鉄道では 2.0",
    "show": false
   }
  },
  {
   "id": "b9",
   "kind": "paragraph",
   "props": {
    "text": "設計最高速度は{{V}}であり，曲げモーメントに対して以下により算出する．"
   }
  },
  {
   "id": "b10",
   "kind": "calc",
   "props": {
    "name": "n_e",
    "expr": "70 * L_b^(-0.8)",
    "unit": "Hz",
    "desc": "載荷時の部材の基本固有振動数"
   }
  },
  {
   "id": "b11",
   "kind": "calc",
   "props": {
    "name": "i",
    "expr": "K_a * V / (7.2 * n_e * L_b) + 10 / (65 + L_b)",
    "digits": 3,
    "desc": "設計衝撃係数"
   }
  },
  {
   "id": "b12",
   "kind": "check",
   "props": {
    "expr": "i <= 0.7"
   }
  },
  {
   "id": "b13",
   "kind": "where",
   "props": {
    "vars": [
     "i",
     "K_a",
     "V",
     "L_b",
     "n_e"
    ]
   }
  },
