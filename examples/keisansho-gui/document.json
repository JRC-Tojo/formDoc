  },
  {
   "id": "b27",
   "kind": "vdef",
   "props": {
    "name": "f_syk",
    "value": 235,
    "unit": "N/mm2",
    "digits": 0,
    "desc": "鋼材の降伏強度の特性値",
    "show": false
   }
  },
  {
   "id": "b28",
   "kind": "calc",
   "props": {
    "name": "bt_0",
    "expr": "R_cr * sqrt(pi^2 * k_0 / (12 * (1 - nu^2)) * E / f_syk)",
    "digits": 1,
    "display": "(b/t)_0"
   }
  },
